local function getTorso(char)
    return char:FindFirstChild("Torso")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("HumanoidRootPart")
end

-- Torso cache: avoids 3x FindFirstChild per player per frame in hitboxRender
local function getCachedTorso(p2)
    if torsoCache[p2] and torsoCache[p2].Parent then
        return torsoCache[p2]
    end
    local char = p2.Character
    if not char then return nil end
    local t = getTorso(char)
    torsoCache[p2] = t
    return t
end

local function invalidateTorsoCache(p2)
    torsoCache[p2] = nil
end

-- Invalidate cache when any player's character respawns
local function hookPlayerCache(p2)
    p2.CharacterAdded:Connect(function()
        invalidateTorsoCache(p2)
    end)
end
for _, p2 in ipairs(Players:GetPlayers()) do hookPlayerCache(p2) end
Players.PlayerAdded:Connect(hookPlayerCache)
Players.PlayerRemoving:Connect(function(p2) torsoCache[p2] = nil end)

local function jitter(base, pct)
    -- returns base ± pct% randomised — breaks flat-interval signatures
    local range = base * pct
    return base + (math.random() * 2 - 1) * range
end

local function keyDisplayName(key)
    local name = key.Name
    -- single letter → [X], multi (F1, LeftAlt …) → first 3 chars
    if #name == 1 then
        return "[" .. name .. "]"
    else
        return "[" .. string.sub(name, 1, 3) .. "]"
    end
end

