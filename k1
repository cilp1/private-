-- Hitbox
local HITBOX_SIZE  = Vector3.new(5, 5, 5)
local DEFAULT_SIZE = Vector3.new(2, 2, 1)

local function applyHitbox(char, enlarged)
    if not char then return end
    local torso = getTorso(char)
    if not torso then return end
    if enlarged then
        torso.Size         = HITBOX_SIZE
        torso.Transparency = 1
        torso.CanCollide   = false
        torso.Material     = Enum.Material.Neon
    else
        torso.Size         = DEFAULT_SIZE
        torso.Transparency = 0
        torso.CanCollide   = true
        torso.Material     = Enum.Material.Plastic
    end
end

local function setHitboxes(enlarged)
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            -- use cache for the enlarged path; bust cache on reset
            if enlarged then
                local torso = getCachedTorso(other)
                if torso then
                    torso.Size         = HITBOX_SIZE
                    torso.Transparency = 1
                    torso.CanCollide   = false
                    torso.Material     = Enum.Material.Neon
                end
            else
                applyHitbox(other.Character, false)
                invalidateTorsoCache(other)
            end
        end
    end
end

local function hitboxActivate()
    hitboxOn = true
    if not hitboxPlayerHooked then
        hitboxPlayerHooked = true
        Players.PlayerAdded:Connect(function(p2)
            if hitboxOn and p2 ~= player then
                p2.CharacterAdded:Connect(function(char)
                    task.wait(0.1)
                    if hitboxOn then applyHitbox(char, true) end
                end)
            end
        end)
    end
end
local function hitboxDeactivate()
    hitboxOn = false
    setHitboxes(false)
end
local function hitboxRender()
    if not hitboxOn then return end
    local now = tick()
    if now - lastHitboxApply < 0.5 then return end  -- throttle to every 500ms
    lastHitboxApply = now
    setHitboxes(true)
end

-- Value edit — rate-limited to 100ms
local function valueRender()
    if not ValueChange2 then return end
    local now = tick()
    if now - lastValueFire < 0.1 then return end
    lastValueFire = now
    local char = player.Character
    if not char then return end
    local wallet = char:FindFirstChild("Wallet")
    if not wallet then return end
    local handle = wallet:FindFirstChild("Handle")
    if not handle then return end
    local bb = handle:FindFirstChild("BillboardGui")
    if not bb then return end
    local label = bb:FindFirstChild("TextLabel")
    if label then
        pcall(function() ValueChange2:FireServer(label, valueText) end)
    end
end

