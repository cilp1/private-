-- LooseFight hook — wrapped in pcall for mobile executor compatibility
local looseFightHookActive = false
pcall(function()
    if not hookmetamethod or not getnamecallmethod then return end
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if getnamecallmethod() == "FireServer" and self == Solo then
