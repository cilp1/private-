                    keyStates[feat.key] = true
                    feat.state = not feat.state
                    if feat.state then feat.onActivate() else feat.onDeactivate() end
                    atualizarGUI()
                elseif not held then
                    keyStates[feat.key] = false
                end
            else -- hold mode
                if held and not feat.state then
                    feat.state = true
                    feat.onActivate()
                    atualizarGUI()
                elseif not held and feat.state then
                    feat.state = false
                    feat.onDeactivate()
                    atualizarGUI()
                end
            end
        end
    end
end)

