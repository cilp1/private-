-- Combo Spam — jittered intervals to reduce detection footprint
-- Stomp runs on its own independent timer so the main loop isn't blocked by the 60s wait
local COMBO_ACTIONS = {"Push", "Punch"}

local function comboActivate()
    -- Independent stomp thread (~30-50s)
    stompThread = task.spawn(function()
        while true do
            pcall(function() MainKeys:FireServer("Stomp") end)
            task.wait(jitter(40, 0.25))
        end
    end)

    -- Independent drag thread (2.6s)
    dragThread = task.spawn(function()
        while true do
            pcall(function() MainKeys:FireServer("Drag") end)
            task.wait(2.6)
        end
    end)

    -- Independent headlock thread (5s)
    headlockThread = task.spawn(function()
        while true do
            pcall(function() MainKeys:FireServer("DamageTool") end)
            task.wait(5)
        end
    end)

    -- Main combo thread: push/punch + escape
    comboThread = task.spawn(function()
        while true do
            for _, action in ipairs(COMBO_ACTIONS) do
                pcall(function() MainKeys:FireServer(action) end)
                task.wait(0.05)
            end

            -- Escape
            pcall(function()
                local char = player.Character
                if not char then return end
                local p2    = char:FindFirstChild("Player")
                local dam   = p2 and p2:FindFirstChild("Damages")
                local vals  = dam and dam:FindFirstChild("values")
                local dt    = vals and vals:FindFirstChild("DamageTool")
                local esc   = dt and dt:FindFirstChild("Escaped")
                if esc and ValueChange then
                    ValueChange:FireServer(esc, true)
                end
            end)
            task.wait(jitter(0.065, 0.23))
        end
    end)
end

local function comboDeactivate()
    if comboThread then task.cancel(comboThread); comboThread = nil end
    if stompThread then task.cancel(stompThread); stompThread = nil end
    if dragThread  then task.cancel(dragThread);  dragThread  = nil end
    if headlockThread then task.cancel(headlockThread); headlockThread = nil end
end

