local function buildPCUI()
    local p=Instance.new("Frame"); p.Size=UDim2.new(0,GUI_W,0,30)
    p.Position=UDim2.new(0,-GUI_W-20,0.15,0); p.BackgroundColor3=C_BG; p.BorderSizePixel=0
    p.Active=true; p.Parent=sg; Instance.new("UICorner",p).CornerRadius=UDim.new(0,14)
    Instance.new("UIStroke",p).Color=Color3.fromRGB(50,50,50)
    TweenService:Create(p,TweenInfo.new(0.6,Enum.EasingStyle.Elastic,Enum.EasingDirection.Out),{Position=UDim2.new(0.02,0,0.15,0)}):Play()

    local tb=Instance.new("Frame"); tb.Size=UDim2.new(1,0,0,34); tb.BackgroundColor3=C_TITLE
    tb.BorderSizePixel=0; tb.ZIndex=2; tb.Parent=p; Instance.new("UICorner",tb).CornerRadius=UDim.new(0,14)
    local tbf=Instance.new("Frame"); tbf.Size=UDim2.new(1,0,0,14); tbf.Position=UDim2.new(0,0,1,-14)
    tbf.BackgroundColor3=C_TITLE; tbf.BorderSizePixel=0; tbf.ZIndex=2; tbf.Parent=tb
    local tba=Instance.new("Frame"); tba.Size=UDim2.new(1,0,0,1); tba.Position=UDim2.new(0,0,1,0)
    tba.BackgroundColor3=Color3.fromRGB(60,60,60); tba.BorderSizePixel=0; tba.ZIndex=3; tba.Parent=tb

    -- Wave title
    local TLETTERS={"F","R","E","E"," ","F","O","R"," ","A","L","L"}
    local LW=16; local tlc=Instance.new("Frame")
    tlc.Size=UDim2.new(0,#TLETTERS*LW,1,0); tlc.Position=UDim2.new(0,6,0,0)
    tlc.BackgroundTransparency=1; tlc.BorderSizePixel=0; tlc.ZIndex=3; tlc.Parent=tb
    local tls={}
    for i,ch in ipairs(TLETTERS) do
        local l=Instance.new("TextLabel"); l.Size=UDim2.new(0,LW,1,0)
        l.Position=UDim2.new(0,(i-1)*LW,0,0); l.BackgroundTransparency=1; l.Text=ch; l.TextSize=13
        l.Font=Enum.Font.GothamBold; l.TextXAlignment=Enum.TextXAlignment.Center
        l.TextStrokeTransparency=0.6; l.ZIndex=3
        l.TextColor3=ch==" " and Color3.new(0,0,0) or C_LABEL
        if ch==" " then l.TextTransparency=1 end
        l.Parent=tlc; tls[i]=l
    end
    task.spawn(function()
        local t=0
        while true do t=t+task.wait(0.05)
            for i,l in ipairs(tls) do
                if TLETTERS[i]~=" " then l.Position=UDim2.new(0,(i-1)*LW,0,math.sin(t*2.5+(i-1)*0.6)*3) end
            end
        end
    end)

    local mb=Instance.new("TextButton"); mb.Size=UDim2.new(0,22,0,22); mb.Position=UDim2.new(1,-28,0.5,-11)
    mb.BackgroundColor3=Color3.fromRGB(40,40,40); mb.BorderSizePixel=0; mb.Text="—"
    mb.TextColor3=Color3.fromRGB(180,180,180); mb.TextSize=13; mb.Font=Enum.Font.GothamBold; mb.ZIndex=4; mb.Parent=tb
    Instance.new("UICorner",mb).CornerRadius=UDim.new(1,0); Instance.new("UIStroke",mb).Color=Color3.fromRGB(70,70,70)

    -- Drag
    local drag,ds,sp=false,nil,nil
    tb.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            drag=true; ds=UIS:GetMouseLocation(); sp=p.Position
        end
    end)
    tb.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            local d=UIS:GetMouseLocation()-ds
            p.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
        end
    end)

    local content=Instance.new("Frame"); content.Size=UDim2.new(1,0,1,-34); content.Position=UDim2.new(0,0,0,34)
    content.BackgroundTransparency=1; content.BorderSizePixel=0; content.ClipsDescendants=false; content.Parent=p

    local expandedH=0; local minimized=false
    mb.MouseButton1Click:Connect(function()
        minimized=not minimized
        if minimized then
            for _,o in ipairs(content:GetDescendants()) do
                if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
                    TweenService:Create(o,TW_FAST,{TextTransparency=1}):Play()
                end
            end
            task.delay(0.12,function()
                content.Visible=false
                TweenService:Create(p,TweenInfo.new(0.25,Enum.EasingStyle.Cubic,Enum.EasingDirection.Out),{Size=UDim2.new(0,GUI_W,0,34)}):Play()
            end)
            mb.Text="+"
        else
            content.Visible=true
            TweenService:Create(p,TweenInfo.new(0.3,Enum.EasingStyle.Cubic,Enum.EasingDirection.Out),{Size=UDim2.new(0,GUI_W,0,expandedH)}):Play()
            task.delay(0.15,function()
                for _,o in ipairs(content:GetDescendants()) do
                    if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
                        TweenService:Create(o,TW_OPEN,{TextTransparency=0}):Play()
                    end
                end
            end)
            mb.Text="—"
        end
    end)

    local infoLabel
    atualizarGUI=function()
        for _,feat in ipairs(features) do
            if feat.dot then TweenService:Create(feat.dot,TW_DOT,{BackgroundColor3=feat.state and C_ON or C_OFF}):Play() end
            if feat.dotGlow then TweenService:Create(feat.dotGlow,TW_DOT,{BackgroundColor3=feat.state and C_ON or C_OFF,BackgroundTransparency=feat.state and 0.7 or 0.92}):Play() end
            if feat.accent then TweenService:Create(feat.accent,TW_DOT,{BackgroundColor3=feat.state and C_ON or Color3.fromRGB(35,35,35)}):Play() end
            if feat.keyLabel then feat.keyLabel.TextColor3=feat.mode=="hold" and C_KEY_HLD or C_KEY end
            if feat.nameLabel then feat.nameLabel.TextColor3=feat.state and C_LABEL or C_DIM end
        end
        if infoLabel then
            local a={}; for _,f in ipairs(features) do if f.state then a[#a+1]=f.name:match("^(%S+)") end end
            infoLabel.Text=#a==0 and "— none active —" or table.concat(a,"  ·  ")
        end
    end

    local yOff=PAD
    for _,feat in ipairs(features) do buildFeatureRow(feat,yOff,content); yOff=yOff+ROW_H+3 end

    if not hookActive then
        for _,feat in ipairs({fLoose,fBeatDn,fDuo}) do
            if feat.nameLabel then feat.nameLabel.Text=feat.name.." *"; feat.nameLabel.TextColor3=Color3.fromRGB(60,60,60) end
