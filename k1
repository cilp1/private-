    feat.dotGlow = dotGlow

    -- Name
    local lbl = Instance.new("TextLabel")
    lbl.Size               = UDim2.new(0.6, 0, 1, 0)
    lbl.Position           = UDim2.new(0, 26, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text               = feat.name
    lbl.TextColor3         = C_DIM
    lbl.TextSize           = 13
    lbl.Font               = Enum.Font.GothamBold
    lbl.TextXAlignment     = Enum.TextXAlignment.Left
    lbl.Parent             = row
    feat.nameLabel         = lbl

    -- Key badge
    local klabel = Instance.new("TextLabel")
    klabel.Size                   = UDim2.new(0, 44, 0, 22)
    klabel.Position               = UDim2.new(1, -50, 0.5, -11)
    klabel.BackgroundColor3       = Color3.fromRGB(30, 30, 30)
    klabel.BackgroundTransparency = 0
    klabel.BorderSizePixel        = 0
    klabel.TextColor3             = C_KEY
    klabel.TextSize               = 10
    klabel.Font                   = Enum.Font.GothamBold
    klabel.TextXAlignment         = Enum.TextXAlignment.Center
    klabel.Text                   = keyLabelText(feat.key, feat.mode)
    klabel.Parent                 = row
    Instance.new("UICorner", klabel).CornerRadius = UDim.new(0, 4)
    local kStroke = Instance.new("UIStroke", klabel)
    kStroke.Color     = Color3.fromRGB(55, 55, 55)
    kStroke.Thickness = 1
    feat.keyLabel = klabel

    local function onLeft()
        if feat.mode ~= "toggle" then return end
        feat.state = not feat.state
        if feat.state then
            feat.onActivate()
            -- spring pulse on activate
            TweenService:Create(dot, TWEEN_SPRING, {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0, 10, 0.5, -6)}):Play()
            task.delay(0.3, function()
                TweenService:Create(dot, TWEEN_DOT, {Size = UDim2.new(0, 8, 0, 8), Position = UDim2.new(0, 12, 0.5, -4)}):Play()
            end)
        else
            feat.onDeactivate()
        end
        TweenService:Create(feat.dotGlow, TWEEN_DOT,
            {BackgroundColor3  = feat.state and C_ON or C_OFF,
             BackgroundTransparency = feat.state and 0.65 or 0.88}):Play()
        TweenService:Create(klabel, TWEEN_ROW,
            {TextColor3 = feat.mode == "hold" and C_KEY_HLD or C_KEY}):Play()
        atualizarGUI()
    end

    local function onRight()
        feat.mode = (feat.mode == "toggle") and "hold" or "toggle"
        if feat.mode == "toggle" and feat.state then
            feat.state = false
            feat.onDeactivate()
        end
        feat.keyLabel.Text = keyLabelText(feat.key, feat.mode)
        TweenService:Create(klabel, TWEEN_ROW,
            {TextColor3 = feat.mode == "hold" and C_KEY_HLD or C_KEY}):Play()
        atualizarGUI()
    end

    local function inputHandler(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then onLeft()
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then onRight()
        end
    end

    for _, obj in ipairs({row, dot, dotGlow, lbl, klabel, accent}) do
        obj.InputBegan:Connect(inputHandler)
    end
end

