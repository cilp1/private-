local atualizarGUI  -- forward declare
local infoLabelRef=nil

local function buildFeatureRow(feat,y,content)
    local row=Instance.new("Frame")
    row.Size=UDim2.new(1,-PAD*2,0,ROW_H); row.Position=UDim2.new(0,PAD,0,y)
    row.BackgroundColor3=Color3.fromRGB(25,25,25); row.BorderSizePixel=0; row.Parent=content
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,8)
    local rs=Instance.new("UIStroke",row); rs.Color=Color3.fromRGB(38,38,38); rs.Thickness=1

    local accent=Instance.new("Frame"); accent.Size=UDim2.new(0,3,0.6,0); accent.Position=UDim2.new(0,0,0.2,0)
    accent.BackgroundColor3=Color3.fromRGB(35,35,35); accent.BorderSizePixel=0; accent.Parent=row
    Instance.new("UICorner",accent).CornerRadius=UDim.new(0,2); feat.accent=accent

    local dot=Instance.new("Frame"); dot.Size=UDim2.new(0,8,0,8); dot.Position=UDim2.new(0,12,0.5,-4)
    dot.BackgroundColor3=C_OFF; dot.BorderSizePixel=0; dot.Parent=row
    Instance.new("UICorner",dot).CornerRadius=UDim.new(1,0); feat.dot=dot

    local dg=Instance.new("Frame"); dg.Size=UDim2.new(0,16,0,16); dg.Position=UDim2.new(0,8,0.5,-8)
    dg.BackgroundColor3=C_OFF; dg.BackgroundTransparency=0.85; dg.BorderSizePixel=0; dg.Parent=row
    Instance.new("UICorner",dg).CornerRadius=UDim.new(1,0); feat.dotGlow=dg

    local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(0.6,0,1,0); lbl.Position=UDim2.new(0,26,0,0)
    lbl.BackgroundTransparency=1; lbl.Text=feat.name; lbl.TextColor3=C_DIM; lbl.TextSize=13
    lbl.Font=Enum.Font.GothamBold; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=row; feat.nameLabel=lbl

    local kl=Instance.new("TextLabel"); kl.Size=UDim2.new(0,44,0,22); kl.Position=UDim2.new(1,-50,0.5,-11)
    kl.BackgroundColor3=Color3.fromRGB(30,30,30); kl.BorderSizePixel=0; kl.TextColor3=C_KEY; kl.TextSize=10
    kl.Font=Enum.Font.GothamBold; kl.TextXAlignment=Enum.TextXAlignment.Center
    kl.Text=keyDisplayName(feat.key); kl.Parent=row
    Instance.new("UICorner",kl).CornerRadius=UDim.new(0,4); Instance.new("UIStroke",kl).Color=Color3.fromRGB(55,55,55)
    feat.keyLabel=kl

    row.MouseEnter:Connect(function()
        TweenService:Create(row,TW_ROW,{BackgroundColor3=C_HOVER}):Play()
        TweenService:Create(rs,TW_ROW,{Color=Color3.fromRGB(55,55,55)}):Play()
        TweenService:Create(lbl,TW_ROW,{TextColor3=C_LABEL}):Play()
        TweenService:Create(accent,TW_ROW,{Size=UDim2.new(0,4,0.7,0)}):Play()
    end)
    row.MouseLeave:Connect(function()
        TweenService:Create(row,TW_ROW,{BackgroundColor3=Color3.fromRGB(22,22,22)}):Play()
        TweenService:Create(rs,TW_ROW,{Color=Color3.fromRGB(32,32,32)}):Play()
        if not feat.state then TweenService:Create(lbl,TW_ROW,{TextColor3=C_DIM}):Play() end
        TweenService:Create(accent,TW_ROW,{Size=UDim2.new(0,3,0.6,0)}):Play()
    end)

    local deb=false
    local function onLeft()
        if feat.mode~="toggle" then return end
        if deb then return end; deb=true; task.delay(0.1,function() deb=false end)
        feat.state=not feat.state
        if feat.state then
            feat.onActivate()
            TweenService:Create(dot,TW_SPRING,{Size=UDim2.new(0,12,0,12),Position=UDim2.new(0,10,0.5,-6)}):Play()
            task.delay(0.3,function() TweenService:Create(dot,TW_DOT,{Size=UDim2.new(0,8,0,8),Position=UDim2.new(0,12,0.5,-4)}):Play() end)
        else feat.onDeactivate() end
        TweenService:Create(dg,TW_DOT,{BackgroundColor3=feat.state and C_ON or C_OFF,BackgroundTransparency=feat.state and 0.65 or 0.88}):Play()
        TweenService:Create(kl,TW_ROW,{TextColor3=feat.mode=="hold" and C_KEY_HLD or C_KEY}):Play()
        if atualizarGUI then atualizarGUI() end
    end
    row.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then onLeft() end
    end)
end

