local features = {}

local function makeFeature(name, key, opts)
    local activate   = opts.onActivate   or function() end
    local deactivate = opts.onDeactivate or function() end
    local f = {
        name         = name,
        key          = key,
        state        = false,
        mode         = "toggle",
        onActivate   = function()
            activate()
            if opts.onRender     then activeRenderCount    = activeRenderCount    + 1 end
            if opts.onHeartbeat  then activeHeartbeatCount = activeHeartbeatCount + 1 end
        end,
        onDeactivate = function()
            deactivate()
            if opts.onRender     then activeRenderCount    = math.max(0, activeRenderCount    - 1) end
            if opts.onHeartbeat  then activeHeartbeatCount = math.max(0, activeHeartbeatCount - 1) end
        end,
        onHeartbeat  = opts.onHeartbeat or nil,
        onRender     = opts.onRender    or nil,
        dot          = nil,
        dotGlow      = nil,
        keyLabel     = nil,
        nameLabel    = nil,
        dotTween     = nil,
    }
    table.insert(features, f)
    return f
end

