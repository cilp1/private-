local ESP_TAG  = "FREE_ESP"
local espOn    = false
local espCache = {}

local function getEspColor(other)
    local char = other.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            local pct = hum.Health / math.max(hum.MaxHealth, 1)
            if pct < 0.4 then return Color3.fromRGB(255, 80, 80)
            elseif pct < 0.7 then return Color3.fromRGB(255, 200, 60) end
        end
    end
    return Color3.fromRGB(255, 255, 255)
end

local function buildEspBillboard(other)
    local char = other.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") or getTorso(char)
    if not root then return end
    if espCache[other] then
        pcall(function() espCache[other]:Destroy() end)
        espCache[other] = nil
    end
    local bb = Instance.new("BillboardGui")
    bb.Name         = ESP_TAG
    bb.Size         = UDim2.new(0, 120, 0, 40)
    bb.StudsOffset  = Vector3.new(0, 3.2, 0)
    bb.AlwaysOnTop  = true
    bb.MaxDistance  = 900
    bb.ResetOnSpawn = false
    bb.Adornee      = root
    bb.Parent       = root
    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size                   = UDim2.new(1, 0, 0.6, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text                   = other.DisplayName
    nameLbl.TextColor3             = Color3.fromRGB(255, 255, 255)
    nameLbl.TextSize               = 14
    nameLbl.Font                   = Enum.Font.GothamBold
    nameLbl.TextStrokeTransparency = 0.4
    nameLbl.TextStrokeColor3       = Color3.new(0, 0, 0)
    nameLbl.TextXAlignment         = Enum.TextXAlignment.Center
    nameLbl.Parent                 = bb
    local distLbl = Instance.new("TextLabel")
    distLbl.Size                   = UDim2.new(1, 0, 0.4, 0)
    distLbl.Position               = UDim2.new(0, 0, 0.6, 0)
    distLbl.BackgroundTransparency = 1
    distLbl.Text                   = ""
    distLbl.TextColor3             = Color3.fromRGB(180, 180, 180)
    distLbl.TextSize               = 10
    distLbl.Font                   = Enum.Font.Gotham
    distLbl.TextStrokeTransparency = 0.5
    distLbl.TextStrokeColor3       = Color3.new(0, 0, 0)
    distLbl.TextXAlignment         = Enum.TextXAlignment.Center
    distLbl.Parent                 = bb
    espCache[other] = bb
    task.spawn(function()
        while espOn and espCache[other] == bb do
            local myChar = player.Character
            local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or getTorso(myChar))
            if myRoot and root and root.Parent then
                local dist = math.floor((myRoot.Position - root.Position).Magnitude)
                distLbl.Text       = dist .. " studs"
                nameLbl.TextColor3 = getEspColor(other)
            end
            task.wait(0.1)
        end
    end)
end

local function removeEspBillboard(other)
    if espCache[other] then
        pcall(function() espCache[other]:Destroy() end)
        espCache[other] = nil
    end
end

local espPlayerHooked = false

local function espActivate()
    espOn = true
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            buildEspBillboard(other)
            other.CharacterAdded:Connect(function()
                task.wait(0.2)
                if espOn then buildEspBillboard(other) end
            end)
        end
    end
    if not espPlayerHooked then
        espPlayerHooked = true
        Players.PlayerAdded:Connect(function(other)
            if not espOn then return end
            task.wait(0.2)
            buildEspBillboard(other)
            other.CharacterAdded:Connect(function()
                task.wait(0.2)
                if espOn then buildEspBillboard(other) end
            end)
        end)
    end
end
local function espDeactivate()
    espOn = false
    for other, _ in pairs(espCache) do
        removeEspBillboard(other)
    end
end

Players.PlayerRemoving:Connect(function(other)
    removeEspBillboard(other)
end)

