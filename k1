local infoLabel  -- forward-declared

local function atualizarGUI()
    for _, feat in ipairs(features) do
        if feat.dot then
            TweenService:Create(feat.dot, TWEEN_DOT,
                {BackgroundColor3 = feat.state and C_ON or C_OFF}):Play()
        end
        if feat.dotGlow then
            TweenService:Create(feat.dotGlow, TWEEN_DOT,
                {BackgroundColor3  = feat.state and C_ON or C_OFF,
                 BackgroundTransparency = feat.state and 0.7 or 0.92}):Play()
        end
        if feat.accent then
            TweenService:Create(feat.accent, TWEEN_DOT,
                {BackgroundColor3 = feat.state and C_ON or Color3.fromRGB(35,35,35)}):Play()
        end
        if feat.keyLabel then
            feat.keyLabel.TextColor3 = (feat.mode == "hold") and C_KEY_HLD or C_KEY
        end
        if feat.nameLabel then
            feat.nameLabel.TextColor3 = feat.state and C_LABEL or C_DIM
        end
    end
    if infoLabel then
        local active = {}
        for _, feat in ipairs(features) do
            if feat.state then active[#active + 1] = feat.name:match("^(%S+)") end
        end
