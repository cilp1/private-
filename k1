    titleFix.Position               = UDim2.new(0, 0, 1, -14)
    titleFix.BackgroundColor3       = C_TITLE
    titleFix.BackgroundTransparency = 0
    titleFix.BorderSizePixel        = 0
    titleFix.ZIndex                 = 2
    titleFix.Parent                 = titleBar

    local titleAccent = Instance.new("Frame")
    titleAccent.Size             = UDim2.new(1, 0, 0, 1)
    titleAccent.Position         = UDim2.new(0, 0, 1, 0)
    titleAccent.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    titleAccent.BorderSizePixel  = 0
    titleAccent.ZIndex           = 3
    titleAccent.Parent           = titleBar

    -- Animated wave title — CHANGE 1 (PC): letters updated to "FREE FOR ALL"
    local TITLE_LETTERS = {"F","R","E","E"," ","F","O","R"," ","A","L","L"}
    local titleLetters  = {}
    local letterW       = 16
    local totalTitleW   = #TITLE_LETTERS * letterW
    local titleContainer = Instance.new("Frame")
    titleContainer.Size                   = UDim2.new(0, totalTitleW, 1, 0)
    titleContainer.Position               = UDim2.new(0, 6, 0, 0)
    titleContainer.BackgroundTransparency = 1
    titleContainer.BorderSizePixel        = 0
    titleContainer.ZIndex                 = 3
    titleContainer.Parent                 = titleBar

    for i, ch in ipairs(TITLE_LETTERS) do
        local lbl = Instance.new("TextLabel")
        lbl.Size               = UDim2.new(0, letterW, 1, 0)
        lbl.Position           = UDim2.new(0, (i-1)*letterW, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text               = ch
        lbl.TextSize           = 13
        lbl.Font               = Enum.Font.GothamBold
        lbl.TextXAlignment     = Enum.TextXAlignment.Center
        lbl.TextStrokeTransparency = 0.6
        lbl.TextStrokeColor3   = Color3.new(0,0,0)
        lbl.ZIndex             = 3
        if ch == " " then
            lbl.TextTransparency = 1
        else
            lbl.TextColor3 = Color3.fromRGB(220, 220, 220)
        end
        lbl.Parent      = titleContainer
        titleLetters[i] = lbl
    end

    task.spawn(function()
        local t = 0
        while true do
            t = t + task.wait(0.05)
            for i, lbl in ipairs(titleLetters) do
                if TITLE_LETTERS[i] ~= " " then
                    local phase = t * 2.5 + (i-1) * 0.6
                    lbl.Position = UDim2.new(0, (i-1)*letterW, 0, math.sin(phase) * 3)
                end
            end
        end
    end)

    local minBtn = Instance.new("TextButton")
    minBtn.Size                   = UDim2.new(0, 22, 0, 22)
    minBtn.Position               = UDim2.new(1, -28, 0.5, -11)
    minBtn.BackgroundColor3       = Color3.fromRGB(40, 40, 40)
    minBtn.BackgroundTransparency = 0
    minBtn.BorderSizePixel        = 0
    minBtn.Text                   = "—"
    minBtn.TextColor3             = Color3.fromRGB(180, 180, 180)
    minBtn.TextSize               = 13
    minBtn.Font                   = Enum.Font.GothamBold
    minBtn.ZIndex                 = 4
    minBtn.Parent                 = titleBar
    Instance.new("UICorner", minBtn).CornerRadius = UDim.new(1, 0)
    local minStroke = Instance.new("UIStroke", minBtn)
    minStroke.Color     = Color3.fromRGB(70, 70, 70)
    minStroke.Thickness = 1
    minBtn.MouseEnter:Connect(function()
        TweenService:Create(minBtn, TWEEN_ROW, {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}):Play()
    end)
    minBtn.MouseLeave:Connect(function()
        TweenService:Create(minBtn, TWEEN_ROW, {BackgroundColor3 = Color3.fromRGB(40, 40, 40)}):Play()
    end)

    -- Drag
    local dragging, dragStart, startPos = false, nil, nil
    titleBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = UIS:GetMouseLocation()
            startPos  = p.Position
        end
    end)
    titleBar.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                      or i.UserInputType == Enum.UserInputType.Touch) then
            local d = UIS:GetMouseLocation() - dragStart
            p.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)

    local content = Instance.new("Frame")
    content.Size                   = UDim2.new(1, 0, 1, -34)
    content.Position               = UDim2.new(0, 0, 0, 34)
    content.BackgroundTransparency = 1
    content.BorderSizePixel        = 0
    content.Parent                 = p

    local minimized  = false
    local expandedH  = 0
    local infoLabel  = nil

    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            for _, obj in ipairs(content:GetDescendants()) do
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    TweenService:Create(obj, TWEEN_FAST, {TextTransparency = 1}):Play()
                end
            end
