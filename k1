-- Auto Block
local blockAnimTrack = nil

local function getBlockAnimTrack()
    -- Check if existing track is still valid
    if blockAnimTrack then
        local ok = pcall(function() return blockAnimTrack.IsPlaying end)
        if not ok then blockAnimTrack = nil end
    end

    if blockAnimTrack then return blockAnimTrack end

    local char = player.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    local ok, result = pcall(function()
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://17287575667"
        local track = animator:LoadAnimation(anim)
        anim:Destroy()
        return track
    end)
    if ok and result then
        blockAnimTrack = result
        return blockAnimTrack
    end
    return nil
end

