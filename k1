    local previewRows   = {}

    local function getPlayerHealth(other)
        local char = other.Character
        if not char then return 0, 100 end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.MaxHealth > 0 then return hum.Health, hum.MaxHealth end
        local plr = char:FindFirstChild("Player")
        if plr then
            local dam  = plr:FindFirstChild("Damages")
            local vals = dam and dam:FindFirstChild("values")
            if vals then
                local hp    = vals:FindFirstChild("Health")
                local maxHp = vals:FindFirstChild("MaxHealth")
                if hp and maxHp and maxHp.Value > 0 then return hp.Value, maxHp.Value end
                if hp then return hp.Value, 100 end
            end
        end
        if hum then return hum.Health, 100 end
        return 100, 100
    end

    local function getHealthColor(pct)
        if pct > 0.6 then return Color3.fromRGB(60, 200, 80)
        elseif pct > 0.3 then return Color3.fromRGB(230, 180, 40)
        else return Color3.fromRGB(210, 50, 50) end
    end

    local function buildPreviewRow(other)
        if previewRows[other] then return end
        local row = Instance.new("Frame")
        row.Size                   = UDim2.new(1, -8, 0, 38)
        row.Position               = UDim2.new(0, 4, 0, 0)
