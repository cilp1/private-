local function getPlayerHealth(other)
    local char = other.Character
    if not char then return 0, 100 end

    -- Try standard Humanoid first
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.MaxHealth > 0 then
        return hum.Health, hum.MaxHealth
    end

    -- Squabble City custom health paths
    local plr = char:FindFirstChild("Player")
    if plr then
        -- Path: Character.Player.Damages.values.Health (NumberValue)
        local dam  = plr:FindFirstChild("Damages")
        local vals = dam and dam:FindFirstChild("values")
        if vals then
            local hp    = vals:FindFirstChild("Health")
            local maxHp = vals:FindFirstChild("MaxHealth")
            if hp and maxHp and maxHp.Value > 0 then
                return hp.Value, maxHp.Value
            end
            -- sometimes just Health with a fixed max of 100
            if hp then return hp.Value, 100 end
        end
        -- Path: Character.Player.Stats.Health
        local stats = plr:FindFirstChild("Stats")
        if stats then
            local hp    = stats:FindFirstChild("Health")
            local maxHp = stats:FindFirstChild("MaxHealth")
            if hp and maxHp and maxHp.Value > 0 then
                return hp.Value, maxHp.Value
            end
            if hp then return hp.Value, 100 end
        end
    end

    -- Fallback: scan char for any IntValue/NumberValue named Health
    local hp = char:FindFirstChild("Health") or char:FindFirstDescendant and char:FindFirstDescendant("Health")
    if hp and (hp:IsA("NumberValue") or hp:IsA("IntValue")) then
        return hp.Value, 100
    end

    -- Last resort: assume full health if humanoid exists but MaxHealth is 0
    if hum then return hum.Health, 100 end
    return 100, 100
end
