    row.BorderSizePixel  = 0
    row.LayoutOrder      = #previewRows + 1
    row.Parent           = previewScroll
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size               = UDim2.new(1, -8, 0, 16)
    nameLbl.Position           = UDim2.new(0, 6, 0, 3)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text               = other.DisplayName
    nameLbl.TextColor3         = Color3.fromRGB(220, 220, 220)
    nameLbl.TextSize           = 11
    nameLbl.Font               = Enum.Font.GothamBold
    nameLbl.TextXAlignment     = Enum.TextXAlignment.Left
    nameLbl.TextTruncate       = Enum.TextTruncate.AtEnd
    nameLbl.Parent             = row

    -- Health bar background
    local healthBar = Instance.new("Frame")
    healthBar.Size             = UDim2.new(1, -8, 0, 5)
    healthBar.Position         = UDim2.new(0, 4, 0, 21)
    healthBar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    healthBar.BorderSizePixel  = 0
    healthBar.Parent           = row
    Instance.new("UICorner", healthBar).CornerRadius = UDim.new(1, 0)

    -- Health fill
    local healthFill = Instance.new("Frame")
    healthFill.Size             = UDim2.new(1, 0, 1, 0)
    healthFill.BackgroundColor3 = Color3.fromRGB(60, 200, 80)
    healthFill.BorderSizePixel  = 0
    healthFill.Parent           = healthBar
    Instance.new("UICorner", healthFill).CornerRadius = UDim.new(1, 0)

    -- Distance label
    local distLbl = Instance.new("TextLabel")
    distLbl.Size               = UDim2.new(1, -8, 0, 10)
    distLbl.Position           = UDim2.new(0, 6, 0, 27)
    distLbl.BackgroundTransparency = 1
    distLbl.Text               = ""
    distLbl.TextColor3         = Color3.fromRGB(110, 110, 110)
    distLbl.TextSize           = 9
    distLbl.Font               = Enum.Font.Gotham
    distLbl.TextXAlignment     = Enum.TextXAlignment.Left
    distLbl.Parent             = row

    previewRows[other] = {
        frame      = row,
        nameLbl    = nameLbl,
        healthFill = healthFill,
        distLbl    = distLbl,
    }
end

local function removePreviewRow(other)
    local row = previewRows[other]
    if row then
        row.frame:Destroy()
        previewRows[other] = nil
    end
end

-- Add existing players
for _, other in ipairs(Players:GetPlayers()) do
    if other ~= player then buildPreviewRow(other) end
end

Players.PlayerAdded:Connect(function(other)
    if other ~= player then buildPreviewRow(other) end
end)
Players.PlayerRemoving:Connect(function(other)
    removePreviewRow(other)
end)

-- Update loop — refresh health, distance, sort by distance
task.spawn(function()
    while true do
        task.wait(0.1)
        local myChar = player.Character
        local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or getTorso(myChar))

        local sorted = {}
        for other, _ in pairs(previewRows) do
            table.insert(sorted, other)
        end
        table.sort(sorted, function(a, b)
            if not myRoot then return false end
            local ac = a.Character
            local bc = b.Character
            local ar = ac and (ac:FindFirstChild("HumanoidRootPart") or getTorso(ac))
            local br = bc and (bc:FindFirstChild("HumanoidRootPart") or getTorso(bc))
            local ad = ar and (myRoot.Position - ar.Position).Magnitude or math.huge
            local bd = br and (myRoot.Position - br.Position).Magnitude or math.huge
            return ad < bd
        end)

        local totalH = 0
        for i, other in ipairs(sorted) do
            local data = previewRows[other]
            if not data then continue end
            data.frame.LayoutOrder = i
            totalH = totalH + 42

            local char = other.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and (char:FindFirstChild("HumanoidRootPart") or getTorso(char))

            -- Health via custom fallback
            local hp, maxHp = getPlayerHealth(other)
            local pct = math.clamp(hp / math.max(maxHp, 1), 0, 1)
            TweenService:Create(data.healthFill, TWEEN_ROW,
                {Size = UDim2.new(pct, 0, 1, 0),
                 BackgroundColor3 = getHealthColor(pct)}):Play()

            -- Distance
            if myRoot and root then
                local dist = math.floor((myRoot.Position - root.Position).Magnitude)
                data.distLbl.Text = dist .. " studs"
            else
                data.distLbl.Text = "out of game"
            end

            -- Dim row if dead/no character
            local alive = char ~= nil and hp > 0
            data.frame.BackgroundColor3 = alive
                and Color3.fromRGB(26, 26, 26)
                or  Color3.fromRGB(20, 20, 20)
            data.nameLbl.TextColor3 = alive
                and Color3.fromRGB(220, 220, 220)
                or  Color3.fromRGB(90, 90, 90)
        end

        -- Resize panel to fit rows (max height 300)
        local newH = math.min(28 + totalH + 4, 300)
        if newH ~= PREVIEW_H then
            PREVIEW_H = newH
            previewPanel:TweenSize(
                UDim2.new(0, PREVIEW_W, 0, newH),
                Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true
            )
        end
        previewScroll.CanvasSize = UDim2.new(0, 0, 0, totalH + 4)
    end
end)

