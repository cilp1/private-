    btn.TextColor3             = Color3.new(1, 1, 1)
    btn.TextSize               = 13
    btn.Font                   = Enum.Font.GothamBold
    btn.Parent                 = selectorFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TWEEN_ROW, {BackgroundTransparency = 0.2}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TWEEN_ROW, {BackgroundTransparency = 0}):Play()
    end)
    btn.MouseButton1Click:Connect(function()
        TweenService:Create(selectorFrame, TWEEN_FAST, {BackgroundTransparency = 1}):Play()
        for _, v in ipairs(selectorFrame:GetDescendants()) do
            if v:IsA("TextLabel") or v:IsA("TextButton") then
                TweenService:Create(v, TWEEN_FAST, {TextTransparency = 1}):Play()
            end
            if v:IsA("Frame") then
                TweenService:Create(v, TWEEN_FAST, {BackgroundTransparency = 1}):Play()
            end
        end
        task.delay(0.2, function()
            selectorFrame:Destroy()
            callback()
        end)
    end)
    return btn
