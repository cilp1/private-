local function findPlayerByName(name)
    name = name:lower()
    for _, p2 in ipairs(Players:GetPlayers()) do
        if p2 ~= player and p2.Name:lower():find(name, 1, true) then
            return p2
        end
    end
    -- also check display names
    for _, p2 in ipairs(Players:GetPlayers()) do
        if p2 ~= player and p2.DisplayName:lower():find(name, 1, true) then
            return p2
        end
    end
    return nil
end

local function stopUnderground()
    undergroundActive = false
    if undergroundThread then
        task.cancel(undergroundThread)
        undergroundThread = nil
    end
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if root then root.CFrame = root.CFrame * CFrame.new(0, 50, 0) end
        if hum  then hum.PlatformStand = false end
    end
end

