-- Hitbox
local HITBOX_SIZE   = Vector3.new(5, 5, 5)
local DEFAULT_SIZE  = Vector3.new(2, 2, 1)
local HITBOX_METHOD = 1
local HITBOX_METHODS = {"Torso", "Head", "Head+Torso", "Root Part"}

local function applyHitbox(char, enlarged)
    if not char then return end
    if HITBOX_METHOD == 1 then
        local torso = getTorso(char)
        if not torso then return end
        torso.Size         = enlarged and HITBOX_SIZE or DEFAULT_SIZE
        torso.Transparency = enlarged and 1 or 0
    elseif HITBOX_METHOD == 2 then
        local head = char:FindFirstChild("Head")
        if not head then return end
        head.Size         = enlarged and HITBOX_SIZE or Vector3.new(2, 1, 1)
        head.Transparency = 0
    elseif HITBOX_METHOD == 3 then
        local torso = getTorso(char)
        local head  = char:FindFirstChild("Head")
        if torso then
            torso.Size         = enlarged and HITBOX_SIZE or DEFAULT_SIZE
            torso.Transparency = 0
        end
        if head then
            head.Size         = enlarged and HITBOX_SIZE or Vector3.new(2, 1, 1)
            head.Transparency = 0
        end
    elseif HITBOX_METHOD == 4 then
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        root.Size         = enlarged and HITBOX_SIZE or Vector3.new(2, 2, 1)
        root.Transparency = 1
    end
end

local function setHitboxes(enlarged)
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            applyHitbox(other.Character, enlarged)
            if not enlarged then invalidateTorsoCache(other) end
        end
    end
end

