local function applyGodHumanoid(hum)
    if not hum then return end
    godOriginalMax         = hum.MaxHealth
    hum.MaxHealth          = math.huge
    hum.Health             = math.huge
    hum.BreakJointsOnDeath = false
    if godHealthConn then godHealthConn:Disconnect() end
    godHealthConn = hum.HealthChanged:Connect(function()
        if hum and hum.Parent then
            hum.MaxHealth = math.huge
            hum.Health    = math.huge
        end
    end)
end

local function godActivate()
    local char = player.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    applyGodHumanoid(hum)
    godHealThread = task.spawn(function()
        while true do
            pcall(function() Solo:FireServer("Health") end)
            task.wait(0.01)
        end
    end)
    godRenderConn = RunService.Heartbeat:Connect(function()
        local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if h then
            if h.MaxHealth ~= math.huge then h.MaxHealth = math.huge end
            if h.Health ~= math.huge    then h.Health    = math.huge end
            h.BreakJointsOnDeath = false
        end
    end)
    if godCharTarget ~= "" then godSendChar() end
end

local function godDeactivate()
    if godHealthConn then godHealthConn:Disconnect(); godHealthConn = nil end
    if godRenderConn  then godRenderConn:Disconnect();  godRenderConn  = nil end
    if godHealThread  then task.cancel(godHealThread);  godHealThread  = nil end
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.MaxHealth          = godOriginalMax
        hum.Health             = godOriginalMax
        hum.BreakJointsOnDeath = true
    end
end

