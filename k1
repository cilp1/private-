-- ─────────────────────────────────────────────
-- Namecall Hook
-- ─────────────────────────────────────────────
local hookActive = false
pcall(function()
    if not hookmetamethod or not getnamecallmethod then return end
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and self == Solo then
            local args = {...}
            if looseFightBlocked and args[1] == "LooseFight" then return nil end
            if beatDownBlocked  and args[1] == "BeatDown"   then return nil end
        end
        if method == "FireServer" and duoBlocked and self == Duo then return nil end
        -- Inescapable HL: block ValueChange(val, true) ONLY when val belongs to ANOTHER player
        if method == "FireServer" and escapeBlocked and self == ValueChange then
            local args = {...}
            if args[1] and args[2] == true then
                local myChar = player.Character
                -- If the value is NOT in our character → it's someone else's escape → block it
                -- If the value IS in our character → it's our own escape → allow it
                local isOurs = myChar and args[1]:IsDescendantOf(myChar)
                if not isOurs then return nil end
            end
        end
        return old(self, ...)
    end)
    hookActive = true
end)

